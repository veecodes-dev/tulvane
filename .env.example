# Copy this file to ".env" (same folder) and put YOUR keys after the = sign.
# Never share the .env file and never upload it anywhere. It is already in .gitignore.

# Stripe TEST secret key. Starts with sk_test_  (Stripe dashboard > Developers > API keys, "Test mode" ON)
STRIPE_SECRET_KEY=

# Claude API key. Starts with sk-ant-  (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Optional
# CHAT_MODEL=claude-haiku-4-5-20251001
# ALLOWED_ORIGINS=http://localhost:8081

# Password for the shop owner page at /admin (choose a long one). If empty, the admin is off.
ADMIN_PASSWORD=

# Only needed when the server is online: Stripe > Developers > Webhooks > signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
